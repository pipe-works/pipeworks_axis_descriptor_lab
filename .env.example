# ─────────────────────────────────────────────────────────────
# Axis Descriptor Lab – Environment Configuration
# Copy this file to .env and adjust for your local setup.
# ─────────────────────────────────────────────────────────────

# Base URL of the locally-running Ollama instance.
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# The Ollama model name used when the frontend doesn't specify one.
# Must be pulled first: `ollama pull gemma2:2b`
DEFAULT_MODEL=gemma2:2b

# Host / port for uvicorn when running `uvicorn app.main:app`
# These are optional; the defaults work fine for local dev.
APP_HOST=127.0.0.1
APP_PORT=8242

# ── Mud Server Integration (Chat Translation) ────────────────
# Set to connect Chat Translation to a mud server's canonical pipeline.
# Unset = standalone mode (lab's own Ollama pipeline).
# MUD_SERVER_URL=https://api.pipe-works.org    # production
# MUD_SERVER_URL=http://localhost:8000          # local dev
# MUD_SERVER_TIMEOUT=120
